/**
 * Definition for singly-linked list.
 * class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode(int x) {
 *         val = x;
 *         next = null;
 *     }
 * }
 */
public class Solution {
    public ListNode detectCycle(ListNode head) {
      ListNode temp=head;
      ListNode end=head;

      while(end!=null && end.next!=null){
        end=end.next.next;
        temp=temp.next;

       if(temp==end){
             break;
        }
      }
  if(end ==null || end.next==null) return null;
      while(head!=temp){
         head=head.next;
         temp=temp.next;
      }
      
      return temp;
    }
}
