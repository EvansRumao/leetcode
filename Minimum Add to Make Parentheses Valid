class Solution {
    public int minAddToMakeValid(String s) {
        Stack<Character> st=new Stack<>();
        int count=0;
        for(int i=0;i<s.length();i++){
            char c=s.charAt(i);
            if(c=='('){
              st.push(c);
            }else{
                if(!st.isEmpty()){
                    st.pop();
                }else{
                    count++;
                }
            }
        }

        if(!st.isEmpty()){
            count +=st.size();
        }

        return count;
    }
}
