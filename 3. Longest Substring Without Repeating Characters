class Solution {
    public int lengthOfLongestSubstring(String s) {
        HashSet<Character> ch = new HashSet<>();

        int left = 0;
        int maxLength = 0;
        int sum=0;
        for (int right = 0; right < s.length(); right++) {
            char c = s.charAt(right);

            while (ch.contains(c)) {
                ch.remove(s.charAt(left));
                left++;
                sum--;
            }

            ch.add(c);
             sum++;
            maxLength = Math.max(maxLength,sum);
        }

        return maxLength;
    }
}
